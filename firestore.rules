rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return signedIn()
        && userProfile().status == 'active'
        && userProfile().role in ['service', 'admin'];
    }

    function isAdmin() {
      return signedIn()
        && userProfile().status == 'active'
        && userProfile().role == 'admin';
    }

    function belongsToAccount(accountId) {
      return signedIn()
        && userProfile().status == 'active'
        && accountId in userProfile().accountIds;
    }

    function validSelfRegistration(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'accountIds',
          'status',
          'createdAt'
        ])
        && (
          (
            request.auth.token.email in [
              'boazaidel@gmail.com',
              'boaz@pacifictrade.co'
            ]
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
            && request.resource.data.accountIds.size() == 0
          )
          ||
          (
            request.resource.data.role == 'customer'
            && request.resource.data.status == 'pending'
            && request.resource.data.accountIds.size() == 0
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create: if validSelfRegistration(userId);
      allow update: if isAdmin() || validSelfRegistration(userId);
      allow delete: if isAdmin();
    }

    // Staff dashboards use collection-group queries across every customer
    // account. These explicit rules keep that access limited to active staff.
    match /{path=**}/machines/{documentId} {
      allow read: if isStaff();
    }

    match /{path=**}/tickets/{documentId} {
      allow read: if isStaff();
    }

    match /{path=**}/orders/{documentId} {
      allow read: if isStaff();
    }

    match /{path=**}/tasks/{documentId} {
      allow read: if isStaff();
    }

    match /accounts/{accountId} {
      allow read: if isStaff() || belongsToAccount(accountId);
      allow write: if isStaff();

      match /machines/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow write: if isStaff();
      }

      match /tickets/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create: if isStaff() || belongsToAccount(accountId);
        allow update, delete: if isStaff();
      }

      match /orders/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create, update: if isStaff() || belongsToAccount(accountId);
        allow delete: if isStaff();
      }

      match /tasks/{documentId} {
        allow read, write: if isStaff();
      }
    }
  }
}
