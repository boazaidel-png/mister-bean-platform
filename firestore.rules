rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return signedIn()
        && userProfile().status == 'active'
        && userProfile().role in ['service', 'admin'];
    }

    function isAdmin() {
      return signedIn()
        && userProfile().status == 'active'
        && userProfile().role == 'admin';
    }

    function belongsToAccount(accountId) {
      return signedIn()
        && userProfile().status == 'active'
        && accountId in userProfile().accountIds;
    }

    function validSelfRegistration(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'accountIds',
          'status',
          'createdAt'
        ])
        && (
          (
            request.auth.token.email in [
              'boazaidel@gmail.com',
              'boaz@pacifictrade.co'
            ]
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
            && request.resource.data.accountIds.size() == 0
          )
          ||
          (
            request.resource.data.role == 'customer'
            && request.resource.data.status == 'pending'
            && request.resource.data.accountIds.size() == 0
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create: if validSelfRegistration(userId);
      allow update: if isAdmin() || validSelfRegistration(userId);
      allow delete: if isAdmin();
    }

    match /mail/{notificationId} {
      allow create: if signedIn()
        && notificationId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'to',
          'replyTo',
          'message',
          'request',
          'createdAt'
        ])
        && request.resource.data.to == ['boaz@pacifictrade.co']
        && request.resource.data.replyTo == request.auth.token.email
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject
          == 'בקשת גישה חדשה למערכת מיסטר בין'
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 1200
        && request.resource.data.request.keys().hasOnly([
          'uid',
          'email',
          'displayName'
        ])
        && request.resource.data.request.uid == request.auth.uid
        && request.resource.data.request.email == request.auth.token.email
        && request.resource.data.request.displayName is string
        && request.resource.data.createdAt is string;
      allow read: if signedIn()
        && (notificationId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /accounts/{accountId} {
      allow read: if isStaff() || belongsToAccount(accountId);
      allow write: if isStaff();

      match /machines/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow write: if isStaff();
      }

      match /tickets/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create: if isStaff() || belongsToAccount(accountId);
        allow update, delete: if isStaff();
      }

      match /orders/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create, update: if isStaff() || belongsToAccount(accountId);
        allow delete: if isStaff();
      }

      match /tasks/{documentId} {
        allow read, write: if isStaff();
      }
    }
  }
}
