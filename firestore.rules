rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return signedIn()
        && userProfile().status == 'active'
        && userProfile().role in ['service', 'admin'];
    }

    function isAdmin() {
      return signedIn()
        && userProfile().status == 'active'
        && userProfile().role == 'admin';
    }

    function belongsToAccount(accountId) {
      return signedIn()
        && userProfile().status == 'active'
        && accountId in userProfile().accountIds;
    }

    function validSelfRegistration(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'accountIds',
          'status',
          'createdAt'
        ])
        && (
          (
            request.auth.token.email in [
              'boazaidel@gmail.com',
              'boaz@pacifictrade.co'
            ]
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
            && request.resource.data.accountIds.size() == 0
          )
          ||
          (
            request.resource.data.role == 'customer'
            && request.resource.data.status == 'pending'
            && request.resource.data.accountIds.size() == 0
          )
        );
    }

    function hasReadyInvite() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/accessInvites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.status == 'ready'
        && get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.email == request.auth.token.email;
    }

    function validInvitedProfile(userId) {
      return hasReadyInvite()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'accountIds',
          'status',
          'createdAt'
        ])
        && request.resource.data.role == get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.role
        && request.resource.data.status == 'active'
        && request.resource.data.accountIds.size() == 1
        && request.resource.data.accountIds[0] == get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.accountId;
    }

    function validInviteAcceptance() {
      return signedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email
        && resource.data.status == 'ready'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'acceptedAt',
          'acceptedByUid'
        ])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedByUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create: if validSelfRegistration(userId) || validInvitedProfile(userId);
      allow update: if isAdmin()
        || validSelfRegistration(userId)
        || (
          resource.data.status == 'pending'
          && resource.data.role == 'customer'
          && resource.data.accountIds.size() == 0
          && validInvitedProfile(userId)
        );
      allow delete: if isAdmin();
    }

    match /accessInvites/{inviteEmail} {
      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.token.email != null
          && inviteEmail == request.auth.token.email
          && resource.data.email == request.auth.token.email
        );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validInviteAcceptance();
    }

    // The commercial workspace is internal. Leads and quotes share the same
    // authenticated staff identity as the service platform.
    match /leads/{leadId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Staff dashboards use collection-group queries across every customer
    // account. These explicit rules keep that access limited to active staff.
    match /{path=**}/machines/{documentId} {
      allow read: if isStaff();
    }

    match /{path=**}/tickets/{documentId} {
      allow read: if isStaff();
    }

    match /{path=**}/orders/{documentId} {
      allow read: if isStaff();
    }

    match /{path=**}/tasks/{documentId} {
      allow read: if isStaff();
    }

    match /{path=**}/activities/{documentId} {
      allow read: if isStaff();
    }

    match /accounts/{accountId} {
      allow read: if isStaff() || belongsToAccount(accountId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']));

      match /machines/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create, delete: if isAdmin();
        allow update: if isStaff();
      }

      match /tickets/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create: if isStaff() || belongsToAccount(accountId);
        allow update, delete: if isStaff();
      }

      match /orders/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create, update: if isStaff() || belongsToAccount(accountId);
        allow delete: if isStaff();
      }

      match /tasks/{documentId} {
        allow read, write: if isStaff();
      }

      match /activities/{documentId} {
        allow read: if isStaff() || belongsToAccount(accountId);
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }
  }
}
