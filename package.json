{
  "name": "mister-bean-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext",
    "test": "npm run test:quote && npm run test:service && npm run test:maintenance && npm run test:profitability && npm run test:backup && npm run test:access && npm run test:security && npm run test:tasting",
    "test:quote": "node --experimental-strip-types --test lib/quote-engine.test.ts",
    "test:service": "node --experimental-strip-types --test lib/service-engine.test.ts",
    "test:maintenance": "node --experimental-strip-types --test lib/maintenance-engine.test.ts",
    "test:profitability": "node --experimental-strip-types --test lib/profitability-engine.test.ts",
    "test:backup": "node --experimental-strip-types --test lib/system-backup.test.ts",
    "test:rules": "node --test lib/firestore-rules.test.mjs",
    "test:access": "node --experimental-strip-types --test lib/access-invite.test.ts",
    "test:security": "node --experimental-strip-types --test lib/security.test.ts",
    "test:tasting": "node --experimental-strip-types --test lib/tasting-engine.test.ts"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "baseline-browser-mapping": "2.11.0",
    "nanoid": "3.3.18"
  },
  "type": "module"
}
