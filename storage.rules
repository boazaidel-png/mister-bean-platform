rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && profile().status == 'active';
    }

    function isStaff() {
      return activeUser() && profile().role in ['service', 'admin'];
    }

    function isAdmin() {
      return activeUser() && profile().role == 'admin';
    }

    function belongsToAccount(accountId) {
      return activeUser() && accountId in profile().accountIds;
    }

    function validEvidence(fileName) {
      return fileName.size() > 0
        && fileName.size() <= 180
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/heic',
          'image/heif',
          'video/mp4',
          'video/quicktime',
          'video/webm'
        ];
    }

    match /accounts/{accountId}/tickets/{ticketId}/{fileName} {
      allow read: if isStaff() || belongsToAccount(accountId);
      allow create: if (isStaff() || belongsToAccount(accountId))
        && validEvidence(fileName);
      allow update: if isStaff() && validEvidence(fileName);
      allow delete: if isAdmin();
    }
  }
}
